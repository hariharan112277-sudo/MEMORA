# Copy this file to .env and edit as needed.

# Flask
FLASK_ENV=development
DEBUG=false
PORT=5000

# Storage backend: "json" (default, zero-setup) or "mongo"
STORAGE_BACKEND=json

# Only needed if STORAGE_BACKEND=mongo
MONGO_URI=mongodb://localhost:27017
MONGO_DB=memora

# Retention threshold used by the revision scheduler (0-1)
RETENTION_THRESHOLD=0.8

# Allowed origin for the frontend dashboard (CORS)
CORS_ORIGIN=*
